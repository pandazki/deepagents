# Environment variables for EvoAgent
# Copy this to .env and fill in your values

# Required: Anthropic API key for Claude
ANTHROPIC_API_KEY=sk-ant-xxx

# Required: GitHub token for pushing mutations
GITHUB_TOKEN=ghp_xxx

# Required: GitHub repository (format: owner/repo)
GITHUB_REPO=your-username/deepagents

# Auto-generated by orchestrator
ORGANISM_ID=org_001
GENOME_BRANCH=evo-seed
